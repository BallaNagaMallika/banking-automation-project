<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Enterprise Banking Suite">

    <listeners>

        <listener class-name="com.vit.bankingManagement.listeners.TestListener"/>

    </listeners>

    <test name="Banking Management Tests">

        <classes>

            <!-- UI Tests -->

            <class name="com.vit.bankingManagement.tests.RegistrationTest"/>

            <class name="com.vit.bankingManagement.tests.NegativeRegistrationTest"/>

            <class name="com.vit.bankingManagement.tests.LoginTest"/>

            <class name="com.vit.bankingManagement.tests.OpenAccountTest"/>

            <class name="com.vit.bankingManagement.tests.TransferFundsTest"/>

            <class name="com.vit.bankingManagement.tests.NegativeTransferTest"/>

            <class name="com.vit.bankingManagement.tests.TransactionHistoryTest"/>

            <!-- API Tests -->

            <class name="com.vit.bankingManagement.tests.AuthAPITest"/>

            <class name="com.vit.bankingManagement.tests.CreateUserAPITest"/>

            <class name="com.vit.bankingManagement.tests.FetchUserAPITest"/>

            <!-- UI + API Integration -->

            <class name="com.vit.bankingManagement.tests.UIAPIIntegrationTest"/>

        </classes>

    </test>

</suite>